+    # singular/near-singular -- np.linalg.inv then returns numerically
+    # meaningless values (observed: negative "distances", which are
+    # impossible for a true Mahalanobis quadratic form). Ledoit-Wolf
+    # shrinkage gives a well-conditioned, always-invertible estimate.
+    from sklearn.covariance import LedoitWolf
+    lw = LedoitWolf().fit(all_calib_latents)
+    stats['cov_inv'] = lw.precision_
 
     Z_normed = all_calib_latents / (np.linalg.norm(all_calib_latents, axis=1, keepdims=True) + 1e-8)
     mu_dir = Z_normed.mean(axis=0)
